# ---------------------------------------------------------------
# Copy this file to .env and fill in real values.
# .env is git-ignored. NEVER commit real keys. (AI-103 rule)
# ---------------------------------------------------------------

# Run without Azure credentials (canned responses) - true / false
MOCK_MODE=true

# --- Azure OpenAI (via Azure AI Foundry) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Search (RAG for the Symptom agent) ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=health-kb

# --- Azure AI Speech (voice in / voice out) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_SPEECH_VOICE=en-IN-NeerjaNeural

# --- Azure AI Content Safety (responsible AI guardrail) ---
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-cs>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=

# --- Accounts ---
# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Without it the app still runs, but every restart signs everyone out,
# and on a host running more than one instance people are signed out at
# random. Set it anywhere other than your own machine.
SECRET_KEY=
SESSION_DAYS=30

# --- Storage ---
# Leave DATABASE_URL empty to use the SQLite file below, which is what
# you want locally. Set it to a Postgres connection string on any hosted
# deployment: a serverless host throws its filesystem away between
# requests, so a file there loses accounts and logs without warning.
#   postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
DB_PATH=health_coach.db
